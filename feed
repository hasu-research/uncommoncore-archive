										<content:encoded><![CDATA[<img width="1280" height="720" src="https://i0.wp.com/uncommoncore.co/wp-content/uploads/2021/06/youtube.png?fit=1280%2C720&amp;ssl=1" class="webfeedsFeaturedVisual wp-post-image" alt="" style="display: block; margin-bottom: 5px; clear:both;max-width: 100%;" link_thumbnail="" decoding="async" srcset="https://i0.wp.com/uncommoncore.co/wp-content/uploads/2021/06/youtube.png?w=1280&amp;ssl=1 1280w, https://i0.wp.com/uncommoncore.co/wp-content/uploads/2021/06/youtube.png?resize=768%2C432&amp;ssl=1 768w" sizes="(max-width: 1280px) 100vw, 1280px" />
