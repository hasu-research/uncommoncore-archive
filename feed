		<title>A New Mental Model for Defi Treasuries</title>
		<link>https://uncommoncore.co/a-new-mental-model-for-defi-treasuries/</link>
					<comments>https://uncommoncore.co/a-new-mental-model-for-defi-treasuries/#comments</comments>
		
		<dc:creator><![CDATA[Hasu]]></dc:creator>
		<pubDate>Thu, 28 Oct 2021 12:33:59 +0000</pubDate>
				<category><![CDATA[Research]]></category>
